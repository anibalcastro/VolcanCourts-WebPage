---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WhatsAppButton from "../components/WhatsApp.astro";
import "../styles/global.css";

const {
  title,
  description = "Volcan Courts, canchas de pickleball en La Fortuna, Costa Rica.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta name="description" content={description} />

    <title>{title} | Volcan Courts</title>
  </head>

  <body class="bg-white font-sans text-gray-900 antialiased">
    <Header />

    <main class="min-h-screen">
      <slot />
    </main>

    <Footer />
    <WhatsAppButton />
  </body>
</html>