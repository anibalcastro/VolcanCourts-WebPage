---
import MainLayout from "../../layouts/MainLayout.astro";
import PageHeader from "../../components/PageHeader.astro";

const categories = [
  {
    name: "Principiantes",
    champions: "Alberto Zuñiga / Thiago Zuñiga",
    runnersUp: "José Gamboa / Daniel Wehrtmann",
    image: "/images/ganadores-principiantes1.jpeg",
  },
  {
    name: "Femenina",
    champions: "Johanna Villegas / Maria Salgado",
    runnersUp: "Sophie Picado / Flor de Liz",
    image: "/images/ganadoras-femenina1.JPG",
  },
  {
    name: "Mixta",
    champions: "Maria Salgado / Alonso Cruz",
    runnersUp: "Ivannia Umaña / Diego Sauma",
    image: "/images/ganadores-mixto1.jpeg",
  },
  {
    name: "Categoría B",
    champions: "Josué Garcia / Fabian Madrigal",
    runnersUp: "Anibal Castro / Jose Logan",
    image: "/images/ganadores-b1.jpg",
  },
  {
    name: "Categoría A",
    champions: "Paulo Murillo / Joaquin Monge",
    runnersUp: "Diego Sauma / Luis Gustavo Moreira",
    image: "/images/ganadores-a1.jpg",
  },
];
---

<MainLayout
  title="I Torneo Volcan Courts"
  description="Resultados y ganadores del primer torneo de Volcan Courts, realizado del 10 al 12 de abril de 2026."
>
  <PageHeader
    eyebrow="10–12 de abril de 2026"
    title="I Torneo Volcan Courts"
    description="Tres días de pickleball, competencia y comunidad en el primer torneo realizado en nuestras canchas."
  />

  <section class="mx-auto max-w-7xl px-5 py-16 sm:px-8 lg:py-24">
    <a
      href="/torneos"
      class="inline-flex items-center font-extrabold text-volcan-blue hover:text-volcan-dark"
    >
      ← Volver a torneos
    </a>

    <div
      class="mt-10 grid grid-cols-1 gap-10 lg:grid-cols-[1.4fr_0.6fr] lg:items-start"
    >
      <div>
        <p
          class="text-sm font-black uppercase tracking-[0.2em] text-volcan-blue"
        >
          Nuestro primer torneo
        </p>

        <h2
          class="mt-3 text-3xl font-black text-volcan-dark sm:text-4xl lg:text-5xl"
        >
          Un evento que marcó el inicio
        </h2>

        <p class="mt-5 text-base leading-relaxed text-volcan-gray sm:text-lg">
          Del 10 al 12 de abril de 2026 celebramos el primer torneo de Volcan
          Courts. Jugadores de diferentes niveles participaron en cinco
          categorías, compartiendo tres días de competencia, deporte y buen
          ambiente.
        </p>
      </div>

      <aside class="rounded-2xl bg-volcan-blue p-7 text-white shadow-xl">
        <h3 class="text-xl font-black">Información del torneo</h3>

        <dl class="mt-6 space-y-5">
          <div>
            <dt class="text-sm font-bold text-blue-200">Fecha</dt>
            <dd class="font-extrabold">10–12 de abril de 2026</dd>
          </div>

          <div>
            <dt class="text-sm font-bold text-blue-200">Lugar</dt>
            <dd class="font-extrabold">Volcan Courts, La Fortuna</dd>
          </div>

          <div>
            <dt class="text-sm font-bold text-blue-200">Categorías</dt>
            <dd class="font-extrabold">5 categorías</dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="bg-gray-50">
    <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:py-28">
      <div class="max-w-3xl">
        <p
          class="text-sm font-black uppercase tracking-[0.2em] text-volcan-blue"
        >
          Resultados
        </p>

        <h2
          class="mt-3 text-3xl font-black text-volcan-dark sm:text-4xl lg:text-5xl"
        >
          Ganadores por categoría
        </h2>

        <p class="mt-5 text-volcan-gray sm:text-lg">
          Felicitamos a todos los jugadores que formaron parte de nuestro primer
          torneo.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-7 md:grid-cols-2 lg:grid-cols-3">
        {
          categories.map((category, index) => (
            <article
              class:list={[
                "overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-lg shadow-blue-950/10",
                index === categories.length - 1
                  ? "md:col-span-2 lg:col-span-1"
                  : "",
              ]}
            >
              <div class="flex aspect-[4/3] items-center justify-center bg-gray-100">
                <img
                  src={category.image}
                  alt={`Ganadores de ${category.name}`}
                  class="aspect-[4/3] w-full object-cover object-[center_30%]"
                  loading="lazy"
                />
              </div>

              <div class="p-6">
                <p class="text-sm font-black uppercase tracking-[0.15em] text-volcan-blue">
                  Categoría
                </p>

                <h3 class="mt-2 text-2xl font-black text-volcan-dark">
                  {category.name}
                </h3>

                <div class="mt-6 border-l-4 border-volcan-green pl-4">
                  <p class="text-sm font-bold text-volcan-gray">Campeones</p>

                  <p class="mt-1 font-black text-volcan-dark">
                    {category.champions}
                  </p>
                </div>

                <div class="mt-5 border-l-4 border-gray-300 pl-4">
                  <p class="text-sm font-bold text-volcan-gray">Subcampeones</p>

                  <p class="mt-1 font-black text-volcan-dark">
                    {category.runnersUp}
                  </p>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-volcan-blue text-white">
    <div
      class="mx-auto flex max-w-7xl flex-col gap-7 px-5 py-16 sm:px-8 md:flex-row md:items-center md:justify-between"
    >
      <div>
        <p
          class="text-sm font-black uppercase tracking-[0.2em] text-volcan-green"
        >
          Próximos eventos
        </p>

        <h2 class="mt-3 text-3xl font-black sm:text-4xl">
          ¿Quieres participar en el próximo torneo?
        </h2>
      </div>

      <a
        href="https://wa.me/50663148883?text=Hola%2C%20quiero%20información%20sobre%20los%20próximos%20torneos%20de%20Volcan%20Courts."
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 rounded-lg bg-volcan-green px-6 py-3.5 text-center font-extrabold text-volcan-dark transition hover:-translate-y-1 hover:bg-lime-300"
      >
        Solicitar información
      </a>
    </div>
  </section>
</MainLayout>
