---
import MainLayout from "../layouts/MainLayout.astro";
import PageHeader from "../components/PageHeader.astro";

import { FaWhatsapp } from "react-icons/fa";
import {
  FaCalendarCheck,
  FaClock,
  FaLocationDot,
} from "react-icons/fa6";

const whatsappMessage =
  "Hola, quiero solicitar información sobre Volcan Courts.";

const whatsappUrl =
  `https://wa.me/50663148883?text=${encodeURIComponent(whatsappMessage)}`;

const reservationUrl =
  "https://pickcr.com/jugar/ajIuu8qN9D96EHdv2zT1";

const mapsUrl =
  "https://maps.app.goo.gl/nVP2wXhvGrRfuntm8";

const mapsEmbedUrl =
  "https://www.google.com/maps?q=Volcan%20Courts%20La%20Fortuna%20Costa%20Rica&output=embed";

---

<MainLayout
  title="Contacto"
  description="Contacta a Volcan Courts, consulta nuestros horarios y reserva tu cancha de pickleball en La Fortuna."
>
  <PageHeader
    eyebrow="Estamos para ayudarte"
    title="Contacto"
    description="Consulta nuestros horarios, ubicación y opciones para reservar tu espacio en Volcan Courts."
  />

  <section class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:py-28">
    <div class="mx-auto max-w-3xl text-center">
      <p
        class="text-sm font-black uppercase tracking-[0.2em] text-volcan-blue"
      >
        Volcan Courts
      </p>

      <h2
        class="mt-3 text-3xl font-black text-volcan-dark sm:text-4xl lg:text-5xl"
      >
        ¿Cómo podemos ayudarte?
      </h2>

      <p class="mt-5 text-base leading-relaxed text-volcan-gray sm:text-lg">
        Reserva una cancha, inscríbete a nuestros Open Play
        o escríbenos si necesitas más información.
      </p>
    </div>

    <div
      class="mt-14 grid grid-cols-1 gap-7 sm:grid-cols-2 lg:grid-cols-4"
    >
      <article
        class="flex flex-col rounded-2xl border border-gray-200 bg-white p-7 shadow-lg shadow-blue-950/5 transition hover:-translate-y-1 hover:shadow-xl"
      >
        <span
          class="flex h-14 w-14 items-center justify-center rounded-full bg-green-100 text-green-600"
        >
          <FaWhatsapp className="h-7 w-7" />
        </span>

        <h3 class="mt-6 text-xl font-black text-volcan-dark">
          WhatsApp
        </h3>

        <p class="mt-3 flex-1 text-volcan-gray">
          Escríbenos para realizar consultas o solicitar información.
        </p>

        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 font-extrabold text-volcan-blue hover:text-volcan-dark"
        >
          +506 6314 8883 →
        </a>
      </article>

      <article
        class="flex flex-col rounded-2xl border border-gray-200 bg-white p-7 shadow-lg shadow-blue-950/5 transition hover:-translate-y-1 hover:shadow-xl"
      >
        <span
          class="flex h-14 w-14 items-center justify-center rounded-full bg-volcan-green/20 text-volcan-blue"
        >
          <FaCalendarCheck className="h-7 w-7" />
        </span>

        <h3 class="mt-6 text-xl font-black text-volcan-dark">
          Reservaciones
        </h3>

        <p class="mt-3 flex-1 text-volcan-gray">
          Consulta la disponibilidad y reserva tu cancha mediante PickCR.
        </p>

        <a
          href={reservationUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 font-extrabold text-volcan-blue hover:text-volcan-dark"
        >
          Reservar en PickCR →
        </a>
      </article>

      <article
        class="flex flex-col rounded-2xl border border-gray-200 bg-white p-7 shadow-lg shadow-blue-950/5 transition hover:-translate-y-1 hover:shadow-xl"
      >
        <span
          class="flex h-14 w-14 items-center justify-center rounded-full bg-volcan-green/20 text-volcan-blue"
        >
          <FaLocationDot className="h-7 w-7" />
        </span>

        <h3 class="mt-6 text-xl font-black text-volcan-dark">
          Ubicación
        </h3>

        <p class="mt-3 flex-1 text-volcan-gray">
          Nos encontramos en La Fortuna de San Carlos, Costa Rica.
        </p>

        <a
          href={mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 font-extrabold text-volcan-blue hover:text-volcan-dark"
        >
          Ver ubicación →
        </a>
      </article>

      <article
        class="flex flex-col rounded-2xl border border-gray-200 bg-white p-7 shadow-lg shadow-blue-950/5 transition hover:-translate-y-1 hover:shadow-xl"
      >
        <span
          class="flex h-14 w-14 items-center justify-center rounded-full bg-volcan-green/20 text-volcan-blue"
        >
          <FaClock className="h-7 w-7" />
        </span>

        <h3 class="mt-6 text-xl font-black text-volcan-dark">
          Horarios
        </h3>

        <div class="mt-3 flex-1 space-y-2 text-volcan-gray">
          <p>
            <strong class="text-volcan-dark">Lunes a sábado:</strong>
            5:00 a. m. – 10:00 p. m.
          </p>

          <p>
            <strong class="text-volcan-dark">Domingo:</strong>
            6:00 a. m. – 5:00 p. m.
          </p>
        </div>
      </article>
    </div>
  </section>

  <section class="bg-gray-50">
    <div
      class="mx-auto grid max-w-7xl grid-cols-1 gap-12 px-5 py-20 sm:px-8 lg:grid-cols-2 lg:items-center lg:py-28"
    >
      <div>
        <p
          class="text-sm font-black uppercase tracking-[0.2em] text-volcan-blue"
        >
          Visítanos
        </p>

        <h2
          class="mt-3 text-3xl font-black text-volcan-dark sm:text-4xl lg:text-5xl"
        >
          Pickleball en La Fortuna
        </h2>

        <p class="mt-5 text-lg leading-relaxed text-volcan-gray">
          Disfruta tres canchas de pickleball rodeadas de naturaleza
          y con una vista privilegiada al Volcán Arenal.
        </p>

        <p class="mt-4 text-lg leading-relaxed text-volcan-gray">
          Utiliza el mapa para obtener indicaciones desde tu ubicación
          y llegar fácilmente a Volcan Courts.
        </p>

        <a
          href={mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-8 inline-flex items-center justify-center gap-2 rounded-lg bg-volcan-blue px-6 py-3.5 font-extrabold text-white transition hover:-translate-y-1 hover:bg-volcan-dark"
        >
          <FaLocationDot className="h-5 w-5" />
          Cómo llegar
        </a>
      </div>

      <div
        class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-xl shadow-blue-950/10"
      >
        <iframe
          src={mapsEmbedUrl}
          title="Ubicación de Volcan Courts"
          class="h-[400px] w-full border-0 lg:h-[500px]"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        >
        </iframe>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:py-28">
    <div
      class="overflow-hidden rounded-3xl bg-volcan-dark p-8 text-white sm:p-12 lg:p-14"
    >
      <div
        class="flex flex-col gap-10 lg:flex-row lg:items-center lg:justify-between"
      >
        <div class="max-w-2xl">
          <p
            class="text-sm font-black uppercase tracking-[0.2em] text-volcan-green"
          >
            Reserva en línea
          </p>

          <h2 class="mt-3 text-3xl font-black sm:text-4xl">
            Tu próxima partida comienza aquí
          </h2>

          <p class="mt-5 text-lg text-gray-300">
            Consulta los horarios disponibles y realiza tu reservación
            directamente mediante PickCR.
          </p>
        </div>

        <a
          href={reservationUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="shrink-0 rounded-lg bg-volcan-green px-7 py-3.5 text-center font-extrabold text-volcan-dark transition hover:-translate-y-1 hover:bg-lime-300"
        >
          Reservar una cancha
        </a>
      </div>
    </div>
  </section>

  <section class="bg-volcan-blue text-white">
    <div
      class="mx-auto flex max-w-7xl flex-col gap-8 px-5 py-16 sm:px-8 md:flex-row md:items-center md:justify-between"
    >
      <div class="max-w-2xl">
        <p
          class="text-sm font-black uppercase tracking-[0.2em] text-volcan-green"
        >
          ¿Necesitas ayuda?
        </p>

        <h2 class="mt-3 text-3xl font-black sm:text-4xl">
          Estamos disponibles por WhatsApp
        </h2>

        <p class="mt-4 text-blue-100">
          Escríbenos si tienes dudas sobre reservaciones, Open Play,
          clases o próximos torneos.
        </p>
      </div>

      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex shrink-0 items-center justify-center gap-3 rounded-lg bg-green-500 px-7 py-3.5 text-center font-extrabold text-white transition hover:-translate-y-1 hover:bg-green-600"
      >
        <FaWhatsapp className="h-6 w-6" />
        Escribir por WhatsApp
      </a>
    </div>
  </section>
</MainLayout>