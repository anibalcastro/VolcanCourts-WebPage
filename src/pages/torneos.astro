---
import MainLayout from "../layouts/MainLayout.astro";
import PageHeader from "../components/PageHeader.astro";

const tournaments = [
  {
    title: "I Torneo Volcan Courts",
    date: "10–12 de abril de 2026",
    description:
      "El primer torneo realizado en Volcan Courts reunió jugadores de diferentes niveles y categorías durante tres días de competencia.",
    image: "/images/torneo-abril-2026.jpeg",
    categories: [
      "Principiantes",
      "Femenina",
      "Mixta",
      "Categoría B",
      "Categoría A",
    ],
    url: "/torneos/primer-torneo-2026",
    status: "Finalizado",
  },

  {
    title: "II Torneo Volcan Courts",
    date: "Setiembre 2026",
    description: "Pronto brindaremos más información del próximo torneo",
    image: "/images/Image13.jpeg",
    categories: [
      "Principiantes",
      "Femenina",
      "Mixta",
      "Categoría B",
      "Categoría A",
    ],
    url: "/torneos/proximo-torneo-2026",
    registrationUrl:
      "https://wa.me/50663148883?text=Hola%2C%20quiero%20inscribirme%20al%20próximo%20torneo.",
    status: "Próximamente",
  },
];
---

<MainLayout
  title="Torneos"
  description="Conoce los próximos torneos y resultados de los eventos realizados en Volcan Courts."
>
  <PageHeader
    eyebrow="Competencia y comunidad"
    title="Torneos"
    description="Conoce nuestros próximos eventos y revive los resultados de los torneos realizados en Volcan Courts."
  />

  <section class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:py-28">
    <div class="max-w-3xl">
      <p class="text-sm font-black uppercase tracking-[0.2em] text-volcan-blue">
        Nuestra historia
      </p>

      <h2
        class="mt-3 text-3xl font-black text-volcan-dark sm:text-4xl lg:text-5xl"
      >
        Torneos
      </h2>

      <p class="mt-5 text-base leading-relaxed text-volcan-gray sm:text-lg">
        Revive la competencia, conoce las categorías participantes y descubre
        quiénes ocuparon los primeros lugares.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-8 lg:grid-cols-2">
      {
        tournaments.map((tournament) => (
          <article class="group overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-xl shadow-blue-950/10">
            <div class="relative overflow-hidden">
              <img
                src={tournament.image}
                alt={tournament.title}
                class="aspect-video w-full object-cover transition duration-500 group-hover:scale-105"
                loading="lazy"
              />

              <span class="absolute left-5 top-5 rounded-full bg-volcan-green px-4 py-2 text-xs font-black uppercase tracking-wide text-volcan-dark shadow-lg">
                {tournament.status}
              </span>
            </div>

            <div class="p-6 sm:p-8">
              <p class="text-sm font-black uppercase tracking-[0.15em] text-volcan-blue">
                {tournament.date}
              </p>
              <h3 class="mt-3 text-2xl font-black text-volcan-dark sm:text-3xl">
                {tournament.title}
              </h3>
              <p class="mt-4 leading-relaxed text-volcan-gray">
                {tournament.description}
              </p>
              <div class="mt-6 flex flex-wrap gap-2">
                {tournament.categories.map((category) => (
                  <span class="rounded-full bg-gray-100 px-3 py-1.5 text-sm font-bold text-gray-700">
                    {category}
                  </span>
                ))}
              </div>
              
              <a
                href={
                  tournament.status === "Próximamente"
                    ? tournament.registrationUrl
                    : tournament.url
                }
                target={
                  tournament.status === "Próximamente" ? "_blank" : undefined
                }
                rel={
                  tournament.status === "Próximamente"
                    ? "noopener noreferrer"
                    : undefined
                }
                class:list={[
                  "mt-8 inline-flex w-full items-center justify-center rounded-lg px-6 py-3.5 font-extrabold transition hover:-translate-y-1 sm:w-auto",
                  tournament.status === "Próximamente"
                    ? "bg-volcan-green text-volcan-dark hover:bg-lime-300"
                    : "bg-volcan-blue text-white hover:bg-volcan-dark",
                ]}
              >
                {tournament.status === "Próximamente"
                  ? "Inscribirse"
                  : "Ver torneo y ganadores"}
              </a>
              
            </div>
          </article>
        ))
      }
    </div>
  </section>
</MainLayout>
