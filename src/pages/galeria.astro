---
import MainLayout from "../layouts/MainLayout.astro";
import PageHeader from "../components/PageHeader.astro";

const images = Array.from({ length: 14 }, (_, index) => ({
  src: `/images/Image${index + 1}.jpeg`,
  alt: `Volcan Courts - Fotografía ${index + 1}`,
}));
---

<MainLayout
  title="Galería"
  description="Fotografías de las canchas, jugadores y eventos de Volcan Courts en La Fortuna."
>
  <PageHeader
    eyebrow="Nuestra comunidad"
    title="Galería"
    description="Conoce nuestras canchas, actividades y experiencias de pickleball en La Fortuna."
  />

  <section class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:py-28">
    <div class="mx-auto max-w-3xl text-center">
      <p
        class="text-sm font-black uppercase tracking-[0.2em] text-volcan-blue"
      >
        Volcan Courts
      </p>

      <h2
        class="mt-3 text-3xl font-black text-volcan-dark sm:text-4xl lg:text-5xl"
      >
        Momentos dentro y fuera de la cancha
      </h2>

      <p class="mt-5 text-base leading-relaxed text-volcan-gray sm:text-lg">
        Disfruta una selección de fotografías de nuestras instalaciones,
        jugadores, clínicas, Open Play y torneos.
      </p>
    </div>

    <div class="mt-14 columns-1 gap-5 sm:columns-2 lg:columns-3">
  {
    images.map((image, index) => (
      <a
        href={image.src}
        target="_blank"
        rel="noopener noreferrer"
        class="group relative mb-5 block w-full break-inside-avoid overflow-hidden rounded-2xl bg-gray-100 shadow-lg shadow-blue-950/10"
        aria-label={`Abrir fotografía ${index + 1}`}
      >
        <img
          src={image.src}
          alt={image.alt}
          loading={index < 3 ? "eager" : "lazy"}
          decoding="async"
          class="h-auto w-full transition duration-500 group-hover:scale-105"
        />

        <div
          class="absolute inset-0 flex items-end bg-gradient-to-t from-volcan-dark/70 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"
        >
        </div>
      </a>
    ))
  }
</div>
  </section>

  <section class="bg-volcan-blue text-white">
    <div
      class="mx-auto flex max-w-7xl flex-col gap-8 px-5 py-16 sm:px-8 md:flex-row md:items-center md:justify-between lg:py-20"
    >
      <div class="max-w-2xl">
        <p
          class="text-sm font-black uppercase tracking-[0.2em] text-volcan-green"
        >
          Vive la experiencia
        </p>

        <h2 class="mt-3 text-3xl font-black sm:text-4xl">
          ¿Listo para entrar a la cancha?
        </h2>

        <p class="mt-4 text-blue-100">
          Reserva tu espacio y disfruta el pickleball en La Fortuna.
        </p>
      </div>

      <a
        href="https://wa.me/50663148883?text=Hola%2C%20quiero%20reservar%20en%20Volcan%20Courts."
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 rounded-lg bg-volcan-green px-6 py-3.5 text-center font-extrabold text-volcan-dark transition hover:-translate-y-1 hover:bg-lime-300"
      >
        Reservar por WhatsApp
      </a>
    </div>
  </section>
</MainLayout>